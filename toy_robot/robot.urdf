<?xml version="1.0" encoding="utf-8"?>
<!-- Toy 2-link planar arm for the Lab 2 warm-up: link 1 = 0.15 m, link 2 = 0.20 m, arm plane 0.05 m above the floor -->
<robot name="toy_2link">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://toy_robot/meshes/base.stl"/></geometry>
      <material name="grey"><color rgba="0.55 0.55 0.6 1"/></material>
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10" velocity="3.14"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://toy_robot/meshes/link1.stl"/></geometry>
      <material name="blue"><color rgba="0.23 0.38 0.71 1"/></material>
    </visual>
  </link>

  <joint name="joint2" type="revolute">
    <origin xyz="0.15 0 0" rpy="0 0 0"/>
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10" velocity="3.14"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://toy_robot/meshes/link2.stl"/></geometry>
      <material name="orange"><color rgba="0.95 0.55 0.15 1"/></material>
    </visual>
  </link>

  <joint name="tool" type="fixed">
    <origin xyz="0.20 0 0" rpy="0 0 0"/>
    <parent link="link2"/>
    <child link="end_effector"/>
  </joint>

  <link name="end_effector">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://toy_robot/meshes/tip.stl"/></geometry>
      <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>
    </visual>
  </link>

</robot>
